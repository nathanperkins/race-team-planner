FROM node:20-alpine

WORKDIR /app

# Install system dependencies for Prisma
RUN apk add --no-cache openssl libc6-compat

# Install global prisma CLI matching package.json so versions cannot drift
COPY package.json ./package.json
RUN PRISMA_VERSION="$(node -p "(require('./package.json').devDependencies?.prisma || require('./package.json').dependencies?.prisma || '').replace(/^[^0-9]*/, '')")" && \
    test -n "$PRISMA_VERSION" && \
    npm install -g "prisma@${PRISMA_VERSION}" && \
    rm package.json

# Copy schema and migrations
COPY prisma ./prisma

# Copy start script for loading secrets
COPY scripts/start.sh ./start.sh
RUN chmod +x ./start.sh

# Entrypoint loads secrets then runs CMD
ENTRYPOINT ["./start.sh"]
CMD ["prisma", "migrate", "deploy"]
